# =========================================================================
#  moder — пример конфигурации.
#  Скопируйте в .env и заполните секретами:
#      cp .env.example .env && chmod 600 .env
#  НИКОГДА не коммитьте реальный .env (он в .gitignore).
# =========================================================================

COMPOSE_PROJECT_NAME=moder

# Порты на хосте (наружу отдаём через Caddy)
NGINX_PORT=39010
PMA_PORT=39011

# --- MySQL ---
# Сгенерировать: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=moder
MYSQL_USER=moder
MYSQL_PASSWORD=change-me-user

# --- phpMyAdmin ---
PMA_ABSOLUTE_URI=https://moder.example.com/phpmyadmin/
UPLOAD_LIMIT=256M

# --- moder: API-токены (Bearer) ---
# Сгенерировать: openssl rand -hex 32
# Пустая переменная = роль отключена (сервис вернёт 401/503).
MODER_TOKEN_AGENT=change-me-agent-token
MODER_TOKEN_MODER=change-me-moder-token
MODER_TOKEN_DEVOPS=change-me-devops-token
# Секрет cookie для UI. Можно оставить пустым — будет выведен из MODER_TOKEN_MODER.
MODER_UI_SECRET=

# --- UI ---
# Hover-превью письма в списке (1 = вкл, 0 = выкл). Удобно выключить, если не нравится.
MODER_UI_EMAIL_HOVER=1

# Часовой пояс модератора (границы «сегодня» и отображение времени).
# В БД время хранится в UTC, показывается в этом поясе.
MODER_TZ=Europe/Moscow

# --- mailer (отправка писем) ---
# По умолчанию DRY-RUN: мейлер только логирует, ничего не отправляет и не меняет.
MAILER_DRY_RUN=1
# batch = за прогон до MAILER_BATCH_SIZE писем; spread = по одному, только в окне
MAILER_MODE=batch
# Дневной лимит отправок (0 = без ограничения)
MAILER_DAILY_LIMIT=5
MAILER_BATCH_SIZE=5
# Окно отправки для MAILER_MODE=spread (локальное время, MAILER_TZ)
MAILER_WINDOW=09:00-18:00
MAILER_TZ=Europe/Moscow
# Пауза между опросами очереди (секунды)
MAILER_POLL_INTERVAL=300
# Минимальная пауза между письмами (секунды); для spread распределяется по окну
MAILER_MIN_GAP_SECONDS=0

# SMTP-аккаунты: ОТДЕЛЬНЫЕ креды на каждый from-адрес.
# Формат JSON: {"from@domain": {"user":"...","pass":"...","host":"smtp.mail.ru","port":465,"from_name":"..."}}
# Пароль для mail.ru — «пароль приложения» (help.mail.ru/mail/security/protection/external).
MAILER_ACCOUNTS=

# Фолбэк на один аккаунт (если MAILER_ACCOUNTS пуст):
MAILER_SMTP_HOST=smtp.mail.ru
MAILER_SMTP_PORT=465
MAILER_SMTP_USER=
MAILER_SMTP_PASS=
MAILER_FROM_NAME=
MAILER_LOG_LEVEL=info
